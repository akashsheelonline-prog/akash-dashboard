      button.onclick =
        function() {

          const newView =
            this.dataset.view;


          /*
            New button opens Create modal.
          */

          if (
            newView === "new"
          ) {

            openCreateModal();

            return;

          }

          const isWatermark =
            newView === "watermark";

          watermarkView.classList.toggle(
            "hidden",
            !isWatermark
          );

          document.querySelector(".main > .cards")
            ?.classList.toggle(
              "hidden",
              isWatermark
            );

          document.querySelector(".main > .panel")
            ?.classList.toggle(
              "hidden",
              isWatermark
            );

          document.querySelector(".main > .top .actions")
            ?.classList.toggle(
              "hidden",
              isWatermark
            );


          document
            .querySelectorAll(
              ".nav button"
            )
            .forEach(
              x =>
                x.classList.remove(
                  "active"
                )
            );


          this.classList.add(
            "active"
          );


          view =
            newView;


          selected.clear();


          const titles = {

            dashboard:
              "Akash Dashboard",

            all:
              "All Tasks",

            due:
              "Due Today",

            overdue:
              "Overdue",

            upcoming:
              "Upcoming",

            completed:
              "Completed",

            cancelled:
              "Cancelled",

            watermark:
              "Watermark"
          };


          if (!isWatermark) {
            watermarkView.classList.add("hidden");

            document.querySelector(".main > .cards")
              ?.classList.remove("hidden");

            document.querySelector(".main > .panel")
              ?.classList.remove("hidden");

            document.querySelector(".main > .top .actions")
              ?.classList.remove("hidden");
          }

          pageTitle.textContent =
            titles[view]
            ||
            "Akash Dashboard";


          render();

        };

    }
  );


