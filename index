<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <title>Akash Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
  <script src="https://unpkg.com/@pdf-lib/fontkit@1.1.1/dist/fontkit.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    .hidden {
      display: none !important;
    }

    /* LOGIN */

    .login {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
    }

    .loginbox {
      width: min(420px, 100%);
      background: #fff;
      border: 1px solid #e5e9f0;
      border-radius: 16px;
      padding: 28px;
      box-shadow: 0 15px 50px #0001;
    }

    .loginbox h1 {
      margin: 0 0 6px;
    }

    .muted {
      color: #6b7280;
      font-size: 13px;
    }

    .loginbox input {
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      border: 1px solid #d6dce6;
      border-radius: 8px;
      font: inherit;
    }

    /* BUTTONS */

    .btn {
      border: 0;
      border-radius: 8px;
      padding: 10px 15px;
      cursor: pointer;
      font-weight: 700;
    }

    .primary {
      background: #2563eb;
      color: white;
    }

    .secondary {
      background: white;
      border: 1px solid #dbe1ea;
      color: #172033;
    }

    .danger {
      background: #fee2e2;
      color: #991b1b;
    }

    .success {
      background: #dcfce7;
      color: #166534;
    }

    .warning {
      background: #fef3c7;
      color: #92400e;
    }

    .btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    /* APP */

    .app {
      display: flex;
      min-height: 100vh;
    }

    .sidebar {
      width: 245px;
      background: #101827;
      color: #fff;
      padding: 24px 16px;
      position: fixed;
      inset: 0 auto 0 0;
    }

    .brand {
      font-size: 21px;
      font-weight: 800;
      padding: 0 10px 28px;
    }

    .brand span {
      font-weight: 400;
      color: #9ca9bd;
    }

    .nav button {
      width: 100%;
      background: none;
      border: 0;
      color: #cbd5e1;
      text-align: left;
      padding: 12px 14px;
      border-radius: 9px;
      font-size: 14px;
      cursor: pointer;
      margin: 2px 0;
    }

    .nav button:hover,
    .nav button.active {
      background: #1f2b3d;
      color: #fff;
    }

    .logout {
      position: absolute;
      bottom: 20px;
      left: 16px;
      right: 16px;
    }

    /* MAIN */

    .main {
      margin-left: 245px;
      flex: 1;
      padding: 28px;
      max-width: 1600px;
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 22px;
    }

    .top h1 {
      margin: 0;
      font-size: 28px;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* CARDS */

    .cards {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 14px;
      margin-bottom: 22px;
    }

    .card {
      background: #fff;
      border: 1px solid #e5e9f0;
      border-radius: 12px;
      padding: 16px;
    }

    .card .n {
      font-size: 25px;
      font-weight: 800;
      margin-top: 7px;
    }

    /* PANEL */

    .panel {
      background: #fff;
      border: 1px solid #e5e9f0;
      border-radius: 12px;
      overflow: hidden;
    }

    .toolbar {
      padding: 15px;
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      border-bottom: 1px solid #e5e9f0;
    }

    .search {
      flex: 1;
      min-width: 220px;
    }

    .toolbar input,
    .toolbar select {
      padding: 10px;
      border: 1px solid #d6dce6;
      border-radius: 8px;
      background: #fff;
    }

    /* TABLE */

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 980px;
    }

    th,
    td {
      padding: 12px 13px;
      border-bottom: 1px solid #edf0f4;
      text-align: left;
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f9fafb;
      color: #4b5563;
      font-size: 12px;
      text-transform: uppercase;
    }

    tr.selected td {
      background: #eff6ff;
    }

    .table-wrap {
      overflow: auto;
    }

    .pill {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .imp {
      background: #fee2e2;
      color: #991b1b;
    }

    .med {
      background: #fef3c7;
      color: #92400e;
    }

    .low {
      background: #e0e7ff;
      color: #3730a3;
    }

    .new {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .completed {
      background: #dcfce7;
      color: #166534;
    }

    .cancelled {
      background: #e5e7eb;
      color: #374151;
    }

    .due {
      background: #fef3c7;
      color: #92400e;
    }

    .overdue {
      background: #fee2e2;
      color: #991b1b;
    }

    .empty {
      text-align: center;
      padding: 40px;
      color: #6b7280;
    }

    /* MODAL */

    .modal {
      position: fixed;
      inset: 0;
      background: #0008;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 9999;
    }

    .modal.show {
      display: flex;
    }

    .modal-box {
      background: white;
      width: min(680px, 100%);
      border-radius: 14px;
      padding: 22px;
    }

    .modal-box h2 {
      margin-top: 0;
    }

    .form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }

    .field input,
    .field textarea,
    .field select {
      padding: 10px;
      border: 1px solid #d6dce6;
      border-radius: 8px;
      font: inherit;
      width: 100%;
    }

    .field textarea {
      min-height: 100px;
      resize: vertical;
    }

    .field input:focus,
    .field textarea:focus,
    .field select:focus {
      outline: none;
      border-color: #2563eb;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 18px;
    }

    @media(max-width:1000px) {

      .cards {
        grid-template-columns: repeat(3, 1fr);
      }

      .sidebar {
        width: 210px;
      }

      .main {
        margin-left: 210px;
      }

    }

    @media(max-width:700px) {

      .app {
        display: block;
      }

      .sidebar {
        position: static;
        width: 100%;
        min-height: auto;
      }

      .main {
        margin-left: 0;
        padding: 16px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .top {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }

      .form {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      .logout {
        position: static;
        margin-top: 10px;
      }

    }


    /* WATERMARK TOOL */
    .watermark-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr);
      gap: 18px;
    }

    .wm-upload {
      display: block;
      width: 100%;
      min-height: 170px;
      border: 2px dashed #cbd5e1;
      border-radius: 12px;
      padding: 28px;
      text-align: center;
      background: #f8fafc;
      cursor: pointer;
      transition: .15s;
    }

    .wm-upload:focus-within,
    .wm-upload:hover {
      border-color: #2563eb;
      background: #eff6ff;
    }

    .wm-upload input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .wm-upload-icon {
      font-size: 34px;
      display: block;
      margin-bottom: 8px;
    }

    .wm-file-list {
      margin-top: 14px;
      display: grid;
      gap: 8px;
    }

    .wm-file {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid #e5e9f0;
      border-radius: 9px;
      background: #fff;
    }

    .wm-file-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 13px;
    }

    .wm-file-size {
      color: #6b7280;
      font-size: 11px;
      margin-left: 5px;
    }

    .wm-remove {
      border: 0;
      background: #fee2e2;
      color: #991b1b;
      border-radius: 7px;
      padding: 6px 9px;
      cursor: pointer;
      font-weight: 700;
      flex: 0 0 auto;
    }

    .wm-settings {
      display: grid;
      gap: 13px;
    }

    .wm-settings .field input[type="range"] {
      padding: 0;
      border: 0;
    }

    .wm-range-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .wm-range-row input {
      flex: 1;
    }

    .wm-range-value {
      min-width: 55px;
      text-align: right;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }

    .wm-color-row {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .wm-color-row input[type="color"] {
      width: 52px;
      height: 40px;
      padding: 3px;
      cursor: pointer;
    }

    .wm-preview {
      min-height: 150px;
      display: grid;
      place-items: center;
      background:
        linear-gradient(45deg, #f1f5f9 25%, transparent 25%),
        linear-gradient(-45deg, #f1f5f9 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, #f1f5f9 75%),
        linear-gradient(-45deg, transparent 75%, #f1f5f9 75%);
      background-size: 22px 22px;
      background-position: 0 0, 0 11px, 11px -11px, -11px 0;
      border: 1px solid #e5e9f0;
      border-radius: 10px;
      overflow: hidden;
      position: relative;
    }

    #wmPreviewText {
      font-weight: 800;
      white-space: nowrap;
      user-select: none;
    }

    .wm-progress {
      margin-top: 14px;
      display: none;
    }

    .wm-progress.show {
      display: block;
    }

    .wm-progress-bar {
      height: 9px;
      background: #e5e7eb;
      border-radius: 999px;
      overflow: hidden;
    }

    .wm-progress-fill {
      width: 0;
      height: 100%;
      background: #2563eb;
      transition: width .15s;
    }

    .wm-result {
      margin-top: 14px;
      display: none;
    }

    .wm-result.show {
      display: block;
    }

    .wm-result-list {
      display: grid;
      gap: 7px;
      margin-top: 10px;
    }

    .wm-result-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 9px 11px;
      border: 1px solid #e5e9f0;
      border-radius: 8px;
      background: #fff;
      font-size: 12px;
    }

    .wm-status {
      font-size: 12px;
      color: #6b7280;
      margin-top: 8px;
    }

    @media(max-width:900px) {
      .watermark-layout {
        grid-template-columns: 1fr;
      }
    }

  </style>
  <style>
@font-face {
  font-family: "Arial Black Custom";
  src: url("./ariblk.ttf") format("truetype");
  font-weight: 900;
  font-style: normal;
}
</style>

</head>

<body>


<!-- =====================================================
     LOGIN
===================================================== -->

<div id="login" class="login">

  <div class="loginbox">

    <h1>Akash Dashboard</h1>

    <p class="muted">
      Sign in to manage your tasks.
    </p>

    <input
      id="email"
      type="email"
      placeholder="Email"
      autocomplete="username">

    <input
      id="password"
      type="password"
      placeholder="Password"
      autocomplete="current-password">

    <button
      id="loginBtn"
      class="btn primary"
      style="width:100%">
      Login
    </button>

    <p
      id="loginMsg"
      class="muted">
    </p>

  </div>

</div>


<!-- =====================================================
     DASHBOARD
===================================================== -->

<div id="app" class="app hidden">

  <aside class="sidebar">

    <div class="brand">
      AKASH <span>DASHBOARD</span>
    </div>

    <nav class="nav">

      <button
        class="active"
        data-view="dashboard">
        ▣ Dashboard
      </button>

      <button data-view="all">
        ▤ All Tasks
      </button>

      <button data-view="new">
        ＋ New
      </button>
      

      <button data-view="due">
        ◷ Due Today
      </button>

      <button data-view="overdue">
        ⚠ Overdue
      </button>

      <button data-view="upcoming">
        ◫ Upcoming
      </button>

      <button data-view="completed">
        ✓ Completed
      </button>

      <button data-view="cancelled">
        ✕ Cancelled
      </button>

      <button data-view="watermark">
        💧 Watermark
      </button>

    </nav>

    <button
      id="logoutBtn"
      class="btn secondary logout">
      Logout
    </button>

  </aside>


  <main class="main">

    <div class="top">

      <div>

        <h1 id="pageTitle">
          Akash Dashboard
        </h1>

        <div
          class="muted"
          id="todayLabel">
        </div>

      </div>


      <div class="actions">

        <button
          class="btn secondary"
          id="editBtn"
          disabled>
          Edit
        </button>

        <button
          class="btn danger"
          id="removeBtn"
          disabled>
          Remove
        </button>

        <button
          class="btn success"
          id="completeBtn"
          disabled>
          ✓ Complete
        </button>

        <button
          class="btn warning"
          id="cancelBtn"
          disabled>
          ✕ Cancel
        </button>

        <button
          class="btn primary"
          id="createBtn">
          + Create
        </button>

      </div>

    </div>



    <!-- =====================================================
         WATERMARK TOOL
    ===================================================== -->
    <section id="watermarkView" class="hidden">

      <div class="watermark-layout">

        <div>
          <section class="panel">
            <div class="toolbar">
              <div>
                <b>PDF Files</b>
                <div class="muted">Select 1 to 10 PDF files</div>
              </div>
            </div>

            <div style="padding:15px">
              <label class="wm-upload" for="wmFiles">
                <div class="wm-upload-icon">📄</div>
                <b>Select PDF files</b>
                <div style="margin-top:8px;font-size:12px;color:#64748b">Click here or drag & drop PDFs</div>
                <div class="muted" style="margin-top:5px">
                  Maximum 10 PDF files
                </div>
                <input
                  id="wmFiles"
                  type="file"
                  accept="application/pdf,.pdf"
                  multiple>
              </label>

              <div id="wmFileList" class="wm-file-list"></div>

              <div id="wmStatus" class="wm-status">
                No PDF selected.
              </div>

              <div id="wmProgress" class="wm-progress">
                <div class="wm-progress-bar">
                  <div id="wmProgressFill" class="wm-progress-fill"></div>
                </div>
                <div id="wmProgressText" class="wm-status">
                  Processing...
                </div>
              </div>

              <div id="wmResult" class="wm-result">
                <div class="success" style="padding:12px;border-radius:9px">
                  ✓ Watermark applied successfully.
                </div>
                <div id="wmResultList" class="wm-result-list"></div>

                <div style="margin-top:14px">
                  <button
                    id="downloadAllWm"
                    class="btn primary"
                    disabled>
                    Download All PDFs
                  </button>
                </div>
              </div>
            </div>
          </section>
        </div>

        <div>
          <section class="panel">
            <div class="toolbar">
              <div>
                <b>Watermark Settings</b>
                <div class="muted">Choose how the watermark should appear</div>
              </div>
            </div>

            <div style="padding:15px" class="wm-settings">

              <div class="field">
                <label>Watermark Text</label>
                <input id="wmText" type="text" value="CONFIDENTIAL"
                       placeholder="Enter watermark text">
              </div>

              <div class="field">
                <label>Font</label>
                <select id="wmFont">
                  <option value="ArialBlack">Arial Black</option>
                  <option value="Helvetica">Helvetica</option>
                  <option value="TimesRoman">Times New Roman</option>
                  <option value="Courier">Courier</option>
                  <option value="HelveticaBold">Helvetica Bold</option>
                  <option value="TimesRomanBold">Times New Roman Bold</option>
                  <option value="CourierBold">Courier Bold</option>
                </select>
              </div>

              <div class="field">
                <label>Font Size</label>
                <input id="wmFontSize" type="number" min="6" max="200" value="40">
              </div>

              <div class="field">
                <label>Font Color</label>
                <div class="wm-color-row">
                  <input id="wmColor" type="color" value="#808080">
                  <span id="wmColorValue" class="muted">#808080</span>
                </div>
              </div>

              <div class="field">
                <label>Opacity</label>
                <div class="wm-range-row">
                  <input id="wmOpacity" type="range" min="5" max="100" value="35">
                  <span id="wmOpacityValue" class="wm-range-value">35%</span>
                </div>
              </div>

              <div class="field">
                <label>Angle</label>
                <div class="wm-range-row">
                  <input id="wmAngle" type="range" min="-90" max="90" value="45">
                  <span id="wmAngleValue" class="wm-range-value">45°</span>
                </div>
              </div>

              <div class="field">
                <label>Position</label>
                <select id="wmPosition">
                  <option value="top-left">Top Left</option>
                  <option value="top-center">Top Center</option>
                  <option value="top-right">Top Right</option>
                  <option value="center-left">Center Left</option>
                  <option value="center" selected>Center</option>
                  <option value="center-right">Center Right</option>
                  <option value="bottom-left">Bottom Left</option>
                  <option value="bottom-center">Bottom Center</option>
                  <option value="bottom-right">Bottom Right</option>
                </select>
              </div>

              <div>
                <label class="field label" style="margin-bottom:6px">Preview</label>
                <div class="wm-preview">
                  <div id="wmPreviewText">CONFIDENTIAL</div>
                </div>
              </div>

              <button id="applyWm" class="btn primary">
                Apply Watermark
              </button>

            </div>
          </section>
        </div>

      </div>
    </section>


        <!-- CARDS -->

    <section class="cards">

      <div class="card">
        <div class="muted">
          Total Tasks
        </div>

        <div
          class="n"
          id="cTotal">
          0
        </div>
      </div>


      <div class="card">
        <div class="muted">
          New
        </div>

        <div
          class="n"
          id="cNew">
          0
        </div>
      </div>


      <div class="card">
        <div class="muted">
          Due Today
        </div>

        <div
          class="n"
          id="cDue">
          0
        </div>
      </div>


      <div class="card">
        <div class="muted">
          Overdue
        </div>

        <div
          class="n"
          id="cOverdue">
          0
        </div>
      </div>


      <div class="card">
        <div class="muted">
          Completed
        </div>

        <div
          class="n"
          id="cCompleted">
          0
        </div>
      </div>


      <div class="card">
        <div class="muted">
          Cancelled
        </div>

        <div
          class="n"
          id="cCancelled">
          0
        </div>
      </div>

    </section>


    <!-- FILTERS -->

    <section class="panel">

      <div class="toolbar">

        <input
          class="search"
          id="search"
          placeholder="Search title or details...">

        <select id="typeFilter">

          <option value="">
            All Types
          </option>

          <option value="Important">
            Important
          </option>

          <option value="Medium">
            Medium
          </option>

          <option value="Low">
            Low
          </option>

        </select>


        <select id="relatedFilter">

          <option value="">
            All Related
          </option>

          <option value="Home">
            Home
          </option>

          <option value="Work">
            Work
          </option>

        </select>


        <select id="statusFilter">

          <option value="">
            All Status
          </option>

          <option value="New">
            New
          </option>

          <option value="Completed">
            Completed
          </option>

          <option value="Cancelled">
            Cancelled
          </option>

        </select>

      </div>


      <!-- TABLE -->

      <div class="table-wrap">

        <table>

          <thead>

            <tr>

              <th>
                <input
                  type="checkbox"
                  id="selectAll">
              </th>

              <th>
                Date
              </th>

              <th>
                Title
              </th>

              <th>
                Details
              </th>

              <th>
                Type
              </th>

              <th>
                Related
              </th>

              <th>
                Due Date
              </th>

              <th>
                Status
              </th>

            </tr>

          </thead>

          <tbody id="tbody"></tbody>

        </table>

      </div>

    </section>

  </main>

</div>


<!-- =====================================================
     CREATE / EDIT MODAL
===================================================== -->

<div
  class="modal"
