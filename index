wmFiles.addEventListener("change", function () {
  const incoming = [...(this.files || [])];

  if (watermarkFiles.length + incoming.length > 10) {
    alert("Maximum 10 PDF files are allowed.");
    this.value = "";
    return;
  }

  const valid = incoming.filter(file =>
    file.type === "application/pdf" ||
    file.name.toLowerCase().endsWith(".pdf")
  );

  if (valid.length !== incoming.length) {
    alert("Only PDF files are allowed.");
  }

  const existing = new Set(
    watermarkFiles.map(file =>
      `${file.name}|${file.size}|${file.lastModified}`
    )
  );

  valid.forEach(file => {
    const key = `${file.name}|${file.size}|${file.lastModified}`;
    if (!existing.has(key)) {
      watermarkFiles.push(file);
      existing.add(key);
    }
  });

  this.value = "";
  resetWatermarkResults();
  renderWatermarkFiles();
});

const wmUpload = document.querySelector(".wm-upload");

["dragenter", "dragover"].forEach(eventName => {
  wmUpload.addEventListener(eventName, e => {
    e.preventDefault();
    e.stopPropagation();
    wmUpload.classList.add("wm-dragover");
  });
});

["dragleave", "drop"].forEach(eventName => {
  wmUpload.addEventListener(eventName, e => {
    e.preventDefault();
    e.stopPropagation();
    wmUpload.classList.remove("wm-dragover");
  });
});

wmUpload.addEventListener("drop", e => {
  const dropped = [...(e.dataTransfer?.files || [])];
  if (!dropped.length) return;

  if (watermarkFiles.length + dropped.length > 10) {
    alert("Maximum 10 PDF files are allowed.");
    return;
  }

  const valid = dropped.filter(file =>
    file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf")
  );

  const existing = new Set(
    watermarkFiles.map(file => `${file.name}|${file.size}|${file.lastModified}`)
  );

  valid.forEach(file => {
    const key = `${file.name}|${file.size}|${file.lastModified}`;
    if (!existing.has(key)) {
      watermarkFiles.push(file);
      existing.add(key);
    }
  });

  if (valid.length !== dropped.length) {
    alert("Only PDF files are allowed.");
  }

  resetWatermarkResults();
  renderWatermarkFiles();
});

