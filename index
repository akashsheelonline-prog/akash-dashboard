);


/* =====================================================
   AUTH STATE LISTENER
===================================================== */

sb.auth.onAuthStateChange(
  async function(
    event,
    session
  ) {

    if (session) {

      showApp();

      await loadTasks();

    }
    else {

      tasks = [];

      selected.clear();

      showLogin();

    }

  }
);


/* =====================================================
   INITIAL AUTH CHECK
===================================================== */

async function initializeApp() {

  /*
    This is the important fix.

    Every time the URL is opened, first check whether
    a valid Supabase session exists.

    No session = login screen.
    Valid session = dashboard.
  */

  const {
    data,
    error
  } =
    await sb.auth.getSession();


  if (error) {

    console.error(
      error
    );

    showLogin();

    return;

  }


  if (
    data &&
    data.session
  ) {

    showApp();

    await loadTasks();

  }
  else {

    showLogin();

  }

}


/* =====================================================
   START APPLICATION
===================================================== */

initializeApp();

