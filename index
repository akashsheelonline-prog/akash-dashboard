/* =====================================================
   LOGIN
===================================================== */

loginBtn.onclick =
  async function() {

    const userEmail =
      email.value.trim();

    const userPassword =
      password.value;


    if (!userEmail) {

      msg(
        "Please enter your email."
      );

      return;

    }


    if (!userPassword) {

      msg(
        "Please enter your password."
      );

      return;

    }


    loginBtn.disabled =
      true;


    msg(
      "Signing in..."
    );


    const {
      data,
      error
    } =
      await sb.auth
        .signInWithPassword({

          email:
            userEmail,

          password:
            userPassword

        });


    loginBtn.disabled =
      false;


    if (error) {

      msg(
        "Login failed: "
        +
        error.message
      );

      return;

    }


    if (!data.session) {

      msg(
        "Login failed. No session created."
      );

      return;

    }


    msg("");

    showApp();

    await loadTasks();

  };


/* =====================================================
