/* =====================================================
   DATE
===================================================== */

function todayISO() {

  const d =
    new Date();

  const local =
    new Date(
      d.getTime()
      -
      d.getTimezoneOffset() * 60000
    );

  return local
    .toISOString()
    .slice(0, 10);
}


/* =====================================================
   ESCAPE HTML
===================================================== */

function esc(value) {

  return String(
    value ?? ""
  ).replace(
    /[&<>"']/g,
    m => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    }[m])
  );

}


/* =====================================================
   DUE STATE
===================================================== */

function dueState(task) {

  if (
    task.status !== "New"
  ) {

    return "";

  }


  if (
    task.due_date <
    todayISO()
  ) {

    return "overdue";

  }


  if (
    task.due_date ===
    todayISO()
  ) {

    return "due";

  }


  return "";

}


