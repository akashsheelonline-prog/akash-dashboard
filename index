  details.value =
    task.details ||
    "";


  type.value =
    task.type ||
    "Medium";


  related.value =
    task.related ||
    "Work";


  dueDate.value =
    task.due_date ||
    todayISO();


  modal.classList.add(
    "show"
  );

}


